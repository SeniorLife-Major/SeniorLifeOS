# Secrets for docker-compose.yml. On the server: copy this file to deployment/.env (next to
# docker-compose.yml), fill every value, and keep it there; it is never committed (.gitignore).
# Compose refuses to start while a required value is empty.
#
# Make each random value on the server, e.g.:
#   openssl rand -hex 32        -> 64 hex characters
#   openssl rand -base64 48     -> a long random string

# Database password, letters and digits only (it goes inside DATABASE_URL).
# Postgres takes it only when its data volume is first created; to change it later, see README.md.
POSTGRES_PASSWORD=

# Signs sign-ins. 32 characters or more, random (openssl rand -base64 48).
JWT_SECRET=

# Hashes ID numbers so duplicates can be found without storing them. 32 characters or more, random.
SENIORLIFE_HASH_KEY=

# Encrypts stored document files. Exactly 64 hex characters (openssl rand -hex 32).
# Keep a copy somewhere safe: files stored with it can't be opened with any other key.
SENIORLIFE_STORAGE_KEY=

# Encrypts paused workflows (a doctor search waiting for an answer). Exactly 64 hex characters.
SENIORLIFE_CHECKPOINT_KEY=

# Groq: doctor search always reads the request with the AI model, and documents may use it.
GROQ_API_KEY=

# Geoapify: finds places typed for a doctor search.
GEOAPIFY_API_KEY=

# Apify: every doctor search asks Practo live through it (about $0.05 a search).
APIFY_API=
# Optional: the most live doctor searches may cost in a day, in dollars (default 2.00).
DOCTOR_FETCH_DAILY_USD=2.00

# Optional: leave empty if not used.
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
LANGSMITH_API_KEY=
