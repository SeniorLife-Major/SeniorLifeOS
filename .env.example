# ==============================================================================
# SeniorLife OS — Environment Variables Reference & Deployment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
APP_NAME=SeniorLife OS
APP_VERSION=1.0.0
APP_ENV=production                  # development | staging | production
DEBUG=false                         # Set to false in production
DEMO_MODE=false                     # Set to true only if running pre-recorded demo cases
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL + AsyncPG)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db_host:5432/seniorlife_os
DATABASE_ECHO=false                 # Set to false in production to prevent SQL query logs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 3. Security & Cryptography
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-secure-random-32-character-secret-in-production
SENIORLIFE_HASH_KEY=your_privacy_hash_salt_key_here

# AES-256-GCM 64-hex character encryption keys (32 bytes):
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SENIORLIFE_STORAGE_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
SENIORLIFE_CHECKPOINT_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100
SENIORLIFE_STORAGE_DIR=var/documents

# ------------------------------------------------------------------------------
# 4. LLM & AI Providers (Groq or OpenAI)
# ------------------------------------------------------------------------------
SENIORLIFE_LLM_PROVIDER=groq        # groq | openai
GROQ_API_KEY=your_groq_api_key_here
SENIORLIFE_LLM_MODEL=openai/gpt-oss-20b
# Optional OpenAI configuration (if SENIORLIFE_LLM_PROVIDER=openai):
# OPENAI_API_KEY=your_openai_api_key_here
# SENIORLIFE_LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 5. Monitoring, Health & Tracing (Optional)
# ------------------------------------------------------------------------------
ACTUATOR_ENABLED=true               # Enables /actuator and /metrics endpoints
LANGSMITH_TRACING=false             # Set to true if monitoring LangGraph workflow traces
# LANGSMITH_API_KEY=your_langsmith_api_key
